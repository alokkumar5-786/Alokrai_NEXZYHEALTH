rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default-deny all storage operations
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Private UID-owned original medical report files (never public URLs)
    match /users/{userId}/reports/{reportId}/{fileName} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && fileName == 'original'
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png')
        && request.resource.metadata != null
        && request.resource.metadata.ownerUid == userId
        && request.resource.metadata.reportId == reportId;

      // Disallow client overwrite/mutation of stored originals
      allow update: if false;

      allow delete: if isOwner(userId);
    }
  }
}
